<Window
    x:Class="GameSubRelay.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="clr-namespace:GameSubRelay.App.Settings"
    Title="GameSubRelay"
    Width="860"
    Height="620"
    WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top"
                BorderBrush="#D0D7DE"
                BorderThickness="0 0 0 1"
                Padding="0 0 0 12"
                Margin="0 0 0 12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GameSubRelay" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="配置音频、翻译、字幕浮层和快捷键" Foreground="#586069" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding RelayStateText}"
                               VerticalAlignment="Center"
                               Foreground="#586069"
                               Margin="0 0 10 0" />
                    <Button Content="开始同传" Width="88" Margin="0 0 8 0" Command="{Binding StartRelayCommand}" />
                    <Button Content="停止同传" Width="88" Margin="0 0 12 0" Command="{Binding StopRelayCommand}" />
                    <Button Content="打开浮层" Width="88" Margin="0 0 8 0" Command="{Binding OpenOverlayCommand}" />
                    <Button Content="{Binding OverlayLockText}" Width="112" Margin="0 0 8 0" Command="{Binding ToggleOverlayLockCommand}" />
                    <Button Content="隐藏浮层" Width="88" Command="{Binding HideOverlayCommand}" />
                </WrapPanel>
            </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 12 0 0">
            <TextBlock Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Foreground="#586069"
                       Margin="0 0 16 0" />
            <Button Content="应用" Width="84" Margin="0 0 8 0" Command="{Binding ApplyCommand}" />
            <Button Content="保存" Width="84" Command="{Binding SaveCommand}" />
        </StackPanel>

        <TabControl>
            <TabItem Header="音频">
                <settings:AudioSettingsView DataContext="{Binding Audio}" />
            </TabItem>
            <TabItem Header="翻译">
                <settings:TranslationSettingsView DataContext="{Binding Translation}" />
            </TabItem>
            <TabItem Header="字幕浮层">
                <settings:OverlaySettingsView DataContext="{Binding Overlay}" />
            </TabItem>
            <TabItem Header="语音输出">
                <settings:TtsSettingsView DataContext="{Binding Tts}" />
            </TabItem>
            <TabItem Header="快捷键">
                <settings:HotkeySettingsView DataContext="{Binding Hotkeys}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
