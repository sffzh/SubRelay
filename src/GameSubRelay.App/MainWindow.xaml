<ui:FluentWindow
    x:Class="GameSubRelay.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="clr-namespace:GameSubRelay.App.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GameSubRelay"
    Width="1160"
    Height="760"
    MinWidth="1040"
    MinHeight="700"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/AppIcon.ico"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource AppWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Height="48"
            Margin="8 0"
            Title="GameSubRelay">
            <ui:TitleBar.Icon>
                <ui:ImageIcon
                    Width="18"
                    Height="18"
                    Source="pack://application:,,,/Assets/AppIcon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Border
            Grid.Row="1"
            Margin="20 8 20 0"
            Padding="20 18"
            Background="{StaticResource AppPanelBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="#172033"
                        Text="实时字幕工作台" />
                    <TextBlock
                        Margin="0 6 0 0"
                        Style="{StaticResource MutedTextStyle}"
                        Text="快速控制语音翻译服务和字幕浮层；详细参数在左侧分类里调整。" />
                </StackPanel>

                <WrapPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Border Margin="0 0 10 0" Style="{StaticResource StatusPillStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#244EA4"
                                Text="同传" />
                            <TextBlock
                                Margin="8 0 0 0"
                                Foreground="#244EA4"
                                Text="{Binding RelayStateText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPillStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#244EA4"
                                Text="系统字幕" />
                            <TextBlock
                                Margin="8 0 0 0"
                                Foreground="#244EA4"
                                Text="{Binding SpeechRecognitionStateText}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20 14 20 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CommandPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="同声传译" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0 0 0 14"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{Binding RelayStateText}" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <ui:Button
                            MinWidth="88"
                            Appearance="Primary"
                            Command="{Binding StartRelayCommand}"
                            Content="开始"
                            Icon="{ui:SymbolIcon Play20}" />
                        <ui:Button
                            MinWidth="88"
                            Margin="8 0 0 0"
                            Appearance="Secondary"
                            Command="{Binding StopRelayCommand}"
                            Content="停止"
                            Icon="{ui:SymbolIcon Stop20}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CommandPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="系统声音字幕" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0 0 0 14"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{Binding SpeechRecognitionStateText}" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <ui:Button
                            MinWidth="88"
                            Appearance="Primary"
                            Command="{Binding StartSpeechRecognitionCommand}"
                            Content="开始字幕"
                            Icon="{ui:SymbolIcon Mic20}" />
                        <ui:Button
                            MinWidth="88"
                            Margin="8 0 0 0"
                            Appearance="Secondary"
                            Command="{Binding StopSpeechRecognitionCommand}"
                            Content="停止字幕"
                            Icon="{ui:SymbolIcon Stop20}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CommandPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="字幕浮层" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0 0 0 14"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{Binding OverlayLockText}" />
                    <WrapPanel Grid.Row="2">
                        <ui:Button
                            MinWidth="80"
                            Margin="0 0 8 8"
                            Command="{Binding OpenOverlayCommand}"
                            Content="打开"
                            Icon="{ui:SymbolIcon Window20}" />
                        <ui:Button
                            MinWidth="80"
                            Margin="0 0 8 8"
                            Command="{Binding ToggleOverlayLockCommand}"
                            Content="锁定"
                            Icon="{ui:SymbolIcon LockClosed20}" />
                        <ui:Button
                            MinWidth="80"
                            Margin="0 0 0 8"
                            Appearance="Transparent"
                            Command="{Binding HideOverlayCommand}"
                            Content="隐藏"
                            Icon="{ui:SymbolIcon EyeOff20}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CommandPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="配置" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0 0 0 14"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{Binding StatusText, TargetNullValue=就绪, FallbackValue=就绪}" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <ui:Button
                            MinWidth="88"
                            Appearance="Secondary"
                            Command="{Binding ApplyCommand}"
                            Content="应用"
                            Icon="{ui:SymbolIcon CheckmarkCircle20}" />
                        <ui:Button
                            MinWidth="88"
                            Margin="8 0 0 0"
                            Appearance="Primary"
                            Command="{Binding SaveCommand}"
                            Content="保存"
                            Icon="{ui:SymbolIcon Save20}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TabControl
            Grid.Row="3"
            Margin="20 16 20 0"
            Background="Transparent"
            BorderThickness="0"
            TabStripPlacement="Left">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabControl}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabControl}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Padding="10"
                                        VerticalAlignment="Stretch"
                                        Background="{StaticResource AppPanelBrush}"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Top" Margin="4 4 4 12">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource AppMutedTextBrush}"
                                                    Text="设置分类" />
                                            </StackPanel>
                                            <TabPanel
                                                Background="Transparent"
                                                IsItemsHost="True"
                                                KeyboardNavigation.TabIndex="1" />
                                        </DockPanel>
                                    </Border>

                                    <Border
                                        Grid.Column="2"
                                        Background="{StaticResource AppPanelBrush}"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <ContentPresenter
                                            x:Name="PART_SelectedContentHost"
                                            ContentSource="SelectedContent"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Width" Value="156" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="Margin" Value="0 0 0 8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border
                                    x:Name="TabRoot"
                                    Padding="12 0"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ContentPresenter
                                        x:Name="HeaderContent"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        ContentSource="Header"
                                        RecognizesAccessKey="True"
                                        TextElement.FontWeight="SemiBold"
                                        TextElement.Foreground="#344054" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource AppPanelAltBrush}" />
                                        <Setter TargetName="TabRoot" Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabRoot" Property="Background" Value="#EEF4FF" />
                                        <Setter TargetName="TabRoot" Property="BorderBrush" Value="#BFD2FF" />
                                        <Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="#1D4ED8" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="HeaderContent" Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="音频设备">
                <settings:AudioSettingsView DataContext="{Binding Audio}" />
            </TabItem>
            <TabItem Header="语音服务">
                <settings:SpeechServicesSettingsView />
            </TabItem>
            <TabItem Header="字幕浮层">
                <settings:OverlaySettingsView DataContext="{Binding Overlay}" />
            </TabItem>
            <TabItem Header="语音输出">
                <settings:TtsSettingsView DataContext="{Binding Tts}" />
            </TabItem>
            <TabItem Header="快捷键">
                <settings:HotkeySettingsView DataContext="{Binding Hotkeys}" />
            </TabItem>
        </TabControl>

        <Border
            Grid.Row="4"
            Margin="20 12 20 16"
            Padding="14 10"
            Background="{StaticResource AppPanelBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{StaticResource AppMutedTextBrush}"
                    Text="{Binding StatusText}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <ui:Button
                        MinWidth="90"
                        Appearance="Secondary"
                        Command="{Binding ApplyCommand}"
                        Content="应用"
                        Icon="{ui:SymbolIcon CheckmarkCircle20}" />
                    <ui:Button
                        MinWidth="90"
                        Margin="8 0 0 0"
                        Appearance="Primary"
                        Command="{Binding SaveCommand}"
                        Content="保存"
                        Icon="{ui:SymbolIcon Save20}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
