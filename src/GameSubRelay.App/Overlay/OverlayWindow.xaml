<Window x:Class="GameSubRelay.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameSubRelay.App"
        Title="SubRelay Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        Left="{Binding Settings.Left, Mode=TwoWay}"
        Top="{Binding Settings.Top, Mode=TwoWay}"
        Width="{Binding Settings.Width, Mode=TwoWay}"
        Height="{Binding Settings.Height, Mode=TwoWay}"
        Opacity="{Binding Settings.Opacity}"
        IsHitTestVisible="True">
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid x:Name="Root"
          Background="#A6000000">
        <Border x:Name="ChromeBorder"
                BorderBrush="#7FFFFFFF"
                BorderThickness="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Thickness}"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="0 0 0 1"
                        Padding="8 4 8 10"
                        Margin="0 0 0 8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding MicrophoneCaption.ChannelLabel}"
                                   Foreground="#D0FFFFFF"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 4" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="原始"
                                       Foreground="#A6FFFFFF"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MicrophoneCaption.SourceText}"
                                       Foreground="White"
                                       FontSize="{Binding Settings.FontSize}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="翻译"
                                       Foreground="#A6FFFFFF"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MicrophoneCaption.TranslatedText}"
                                       Foreground="White"
                                       FontSize="{Binding Settings.FontSize}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Padding="8 4 8 0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding MonitorCaption.ChannelLabel}"
                                   Foreground="#D0FFFFFF"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 4" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="原始"
                                       Foreground="#A6FFFFFF"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MonitorCaption.SourceText}"
                                       Foreground="White"
                                       FontSize="{Binding Settings.FontSize}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="翻译"
                                       Foreground="#A6FFFFFF"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MonitorCaption.TranslatedText}"
                                       Foreground="White"
                                       FontSize="{Binding Settings.FontSize}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Canvas HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16"
                        Margin="0 0 0 0"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Rectangle x:Name="ResizeGrip"
                               Width="16"
                               Height="16"
                               Fill="#CCFFFFFF"
                               RadiusX="2"
                               RadiusY="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Cursor="SizeNWSE" />
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
