<Application
    x:Class="GameSubRelay.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GameSubRelay.App"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F4F7FB" />
            <SolidColorBrush x:Key="AppPanelBrush" Color="#FDFEFF" />
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#F7FAFD" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#D8E1EA" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#5F6B7A" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#92400E" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#B91C1C" />

            <Style x:Key="PageTitleTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#172033" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#172033" />
                <Setter Property="Margin" Value="0 0 0 12" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="FieldLabelTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#344054" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionPanelStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource AppPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="Margin" Value="0 0 0 14" />
            </Style>

            <Style x:Key="CommandPanelStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource SectionPanelStyle}">
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <Style x:Key="StatusPillStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="#EEF4FF" />
                <Setter Property="BorderBrush" Value="#BFD2FF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10 6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
