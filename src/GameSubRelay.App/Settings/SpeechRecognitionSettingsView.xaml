<UserControl
    x:Class="GameSubRelay.App.Settings.SpeechRecognitionSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Margin="0 0 0 18">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="语音识别" />
                <TextBlock
                    Margin="0 6 0 0"
                    Style="{StaticResource MutedTextStyle}"
                    Text="配置播放设备通道的语音识别服务、识别语言和火山凭据。" />
            </StackPanel>

            <Border Style="{StaticResource SectionPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="服务" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding Providers}"
                        SelectedValue="{Binding Provider, Mode=TwoWay}"
                        SelectedValuePath="Code" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0 14 0 0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="识别语言" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0 14 0 0"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding AvailableLanguages}"
                        SelectedValue="{Binding Language, Mode=TwoWay}"
                        SelectedValuePath="Code" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="0 14 0 0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="区域" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0 14 0 0"
                        Text="{Binding Region}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionPanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="火山语音识别凭据" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource FieldLabelTextStyle}"
                            Text="APP ID" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding AccessKeyId}" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="0 14 0 0"
                            Style="{StaticResource FieldLabelTextStyle}"
                            Text="Access Token" />
                        <PasswordBox
                            x:Name="SecretAccessKeyBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0 14 0 0"
                            PasswordChanged="SecretAccessKeyPasswordChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionPanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="运行与测试" />
                    <WrapPanel Margin="0 0 0 10">
                        <ui:Button
                            MinWidth="112"
                            Margin="0 0 8 8"
                            Appearance="Primary"
                            Command="{Binding DataContext.StartSpeechRecognitionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="开始识别"
                            Icon="{ui:SymbolIcon Mic20}" />
                        <ui:Button
                            MinWidth="112"
                            Margin="0 0 12 8"
                            Appearance="Secondary"
                            Command="{Binding DataContext.StopSpeechRecognitionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="停止识别"
                            Icon="{ui:SymbolIcon Stop20}" />
                        <TextBlock
                            Margin="0 0 0 8"
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedTextStyle}"
                            Text="{Binding DataContext.SpeechRecognitionStateText, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:Button
                            Grid.Row="0"
                            MinWidth="112"
                            Appearance="Secondary"
                            Command="{Binding TestConnectionCommand}"
                            Content="测试连接"
                            Icon="{ui:SymbolIcon PlugConnected20}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="12 0 0 0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource AppSuccessBrush}"
                            Text="{Binding ConnectionTestStatus}"
                            TextWrapping="Wrap" />

                        <ui:Button
                            Grid.Row="1"
                            MinWidth="112"
                            Margin="0 10 0 0"
                            Appearance="Secondary"
                            Command="{Binding TestFunctionCommand}"
                            Content="测试功能"
                            Icon="{ui:SymbolIcon BeakerSettings20}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="12 10 0 0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource AppSuccessBrush}"
                            Text="{Binding FunctionTestStatus}"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
