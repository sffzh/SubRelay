<UserControl x:Class="GameSubRelay.App.Settings.SpeechRecognitionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="12"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="语言识别服务" FontWeight="SemiBold" FontSize="16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="服务" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding Providers}"
                          SelectedValue="{Binding Provider, Mode=TwoWay}"
                          SelectedValuePath="Code"
                          DisplayMemberPath="DisplayText" />

                <TextBlock Grid.Row="1" Text="识别语言" VerticalAlignment="Center" Margin="0 12 0 0" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0 12 0 0"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedValue="{Binding Language, Mode=TwoWay}"
                          SelectedValuePath="Code"
                          DisplayMemberPath="DisplayText" />

                <TextBlock Grid.Row="2" Text="区域" VerticalAlignment="Center" Margin="0 12 0 0" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0 12 0 0" Text="{Binding Region}" />
            </Grid>

            <TextBlock Text="火山语音识别凭据" FontWeight="SemiBold" Margin="0 10 0 0" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="APP ID" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AccessKeyId}" />

                <TextBlock Grid.Row="1" Text="Access Token" VerticalAlignment="Center" Margin="0 12 0 0" />
                <PasswordBox x:Name="SecretAccessKeyBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="0 12 0 0"
                             PasswordChanged="SecretAccessKeyPasswordChanged" />
            </Grid>

            <TextBlock Text="运行控制" FontWeight="SemiBold" Margin="0 10 0 0" />
            <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                <Button Content="开始识别"
                        Width="108"
                        Command="{Binding DataContext.StartSpeechRecognitionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Content="停止识别"
                        Width="108"
                        Margin="8 0 0 0"
                        Command="{Binding DataContext.StopSpeechRecognitionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="{Binding DataContext.SpeechRecognitionStateText, RelativeSource={RelativeSource AncestorType=Window}}"
                           VerticalAlignment="Center"
                           Margin="12 0 0 0"
                           Foreground="#586069" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                <Button Content="测试连接" Width="108" Command="{Binding TestConnectionCommand}" />
                <TextBlock Text="{Binding ConnectionTestStatus}"
                           VerticalAlignment="Center"
                           Margin="12 0 0 0"
                           Foreground="DarkGreen" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                <Button Content="测试功能" Width="108" Command="{Binding TestFunctionCommand}" />
                <TextBlock Text="{Binding FunctionTestStatus}"
                           VerticalAlignment="Center"
                           Margin="12 0 0 0"
                           Foreground="DarkGreen"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
