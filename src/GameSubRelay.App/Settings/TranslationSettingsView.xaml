<UserControl
    x:Class="GameSubRelay.App.Settings.TranslationSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Margin="0 0 0 18">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="我的语音输出" />
                <TextBlock
                    Margin="0 6 0 0"
                    Style="{StaticResource MutedTextStyle}"
                    Text="配置麦克风同声传译方向、服务商和凭据，例如中文麦克风转英文语音。" />
            </StackPanel>

            <Border Style="{StaticResource SectionPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="语音翻译服务商" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding Providers}"
                        SelectedValue="{Binding Provider, Mode=TwoWay}"
                        SelectedValuePath="Code" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0 14 0 0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="源语言" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0 14 0 0"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding AvailableSourceLanguages}"
                        SelectedValue="{Binding SourceLanguage, Mode=TwoWay}"
                        SelectedValuePath="Code" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="0 14 0 0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="目标语言" />
                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0 14 0 0"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding AvailableTargetLanguages}"
                        SelectedValue="{Binding TargetLanguage, Mode=TwoWay}"
                        SelectedValuePath="Code" />

                    <TextBlock
                        Grid.Row="3"
                        Margin="0 14 0 0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="区域" />
                    <TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0 14 0 0"
                        Text="{Binding Region}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionPanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="服务商凭据（当前：火山 AST）" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Style="{StaticResource FieldLabelTextStyle}"
                            Text="APP ID" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding AccessKeyId}" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="0 14 0 0"
                            Style="{StaticResource FieldLabelTextStyle}"
                            Text="Access Token" />
                        <PasswordBox
                            x:Name="SecretAccessKeyBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0 14 0 0"
                            PasswordChanged="SecretAccessKeyPasswordChanged" />
                    </Grid>
                    <TextBlock
                        Margin="0 12 0 0"
                        Style="{StaticResource MutedTextStyle}"
                        Text="语言选项来自当前服务商能力；非中英互译时，源语言或目标语言至少一个应为中文或英语；中英互译需要源语言和目标语言都选择 zhen。" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionPanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="运行与测试" />
                    <WrapPanel Margin="0 0 0 10">
                        <ui:Button
                            MinWidth="112"
                            Margin="0 0 8 8"
                            Appearance="Primary"
                            Command="{Binding DataContext.StartRelayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="开始同传"
                            Icon="{ui:SymbolIcon Play20}" />
                        <ui:Button
                            MinWidth="112"
                            Margin="0 0 12 8"
                            Appearance="Secondary"
                            Command="{Binding DataContext.StopRelayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="停止同传"
                            Icon="{ui:SymbolIcon Stop20}" />
                        <TextBlock
                            Margin="0 0 0 8"
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedTextStyle}"
                            Text="{Binding DataContext.RelayStateText, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </WrapPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:Button
                            Grid.Row="0"
                            MinWidth="112"
                            Appearance="Secondary"
                            Command="{Binding TestConnectionCommand}"
                            Content="测试连接"
                            Icon="{ui:SymbolIcon PlugConnected20}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="12 0 0 0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource AppSuccessBrush}"
                            Text="{Binding ConnectionTestStatus}"
                            TextWrapping="Wrap" />

                        <ui:Button
                            Grid.Row="1"
                            MinWidth="112"
                            Margin="0 10 0 0"
                            Appearance="Secondary"
                            Command="{Binding TestFunctionCommand}"
                            Content="测试麦克风"
                            Icon="{ui:SymbolIcon BeakerSettings20}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="12 10 0 0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource AppSuccessBrush}"
                            Text="{Binding FunctionTestStatus}"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
