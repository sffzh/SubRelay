<UserControl x:Class="GameSubRelay.App.Settings.TranslationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameSubRelay.App"
             Margin="12"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="翻译服务" FontWeight="SemiBold" FontSize="16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="服务" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding Providers}"
                          SelectedValue="{Binding Provider, Mode=TwoWay}"
                          SelectedValuePath="Code"
                          DisplayMemberPath="DisplayText" />

                <TextBlock Grid.Row="1" Text="源语言" VerticalAlignment="Center" Margin="0 12 0 0" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0 12 0 0"
                          ItemsSource="{Binding AvailableSourceLanguages}"
                          SelectedValue="{Binding SourceLanguage, Mode=TwoWay}"
                          SelectedValuePath="Code"
                          DisplayMemberPath="DisplayText" />

                <TextBlock Grid.Row="2" Text="目标语言" VerticalAlignment="Center" Margin="0 12 0 0" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0 12 0 0"
                          ItemsSource="{Binding AvailableTargetLanguages}"
                          SelectedValue="{Binding TargetLanguage, Mode=TwoWay}"
                          SelectedValuePath="Code"
                          DisplayMemberPath="DisplayText" />

                <TextBlock Grid.Row="3" Text="区域" VerticalAlignment="Center" Margin="0 12 0 0" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0 12 0 0" Text="{Binding Region}" />
            </Grid>

            <TextBlock Text="火山凭据" FontWeight="SemiBold" Margin="0 10 0 0" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="App Key" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AccessKeyId}" />

                <TextBlock Grid.Row="1" Text="Access Key" VerticalAlignment="Center" Margin="0 12 0 0" />
                <PasswordBox x:Name="SecretAccessKeyBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="0 12 0 0"
                             PasswordChanged="SecretAccessKeyPasswordChanged" />
            </Grid>

            <TextBlock Text="提示：非中英互译时，源语言或目标语言至少一个应为中文或英语；中英互译需要源语言和目标语言都选择 zhen。"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="0 10 0 0" />

            <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                <Button Content="测试连接" Width="108" Command="{Binding TestConnectionCommand}" />
                <TextBlock Text="{Binding ConnectionTestStatus}"
                           VerticalAlignment="Center"
                           Margin="12 0 0 0"
                           Foreground="DarkGreen" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
