<UserControl x:Class="GameSubRelay.App.Settings.AudioSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameSubRelay.App"
             Margin="12">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0 0 0 8">
                <TextBlock Text="音频设备" FontWeight="SemiBold" FontSize="16" DockPanel.Dock="Left" />
                <Button Content="刷新设备"
                        Width="96"
                        HorizontalAlignment="Right"
                        Command="{Binding DataContext.RefreshAudioDevicesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DockPanel>
            <TextBlock Text="{Binding DeviceStatusText}"
                       Foreground="Gray"
                       Margin="0 0 0 8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="麦克风设备" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding AvailableMicrophones}"
                          SelectedValue="{Binding SelectedMicrophoneDevice, Mode=TwoWay}"
                          SelectedValuePath="DeviceId"
                          DisplayMemberPath="DisplayText" />

                <TextBlock Grid.Row="1" Text="语音识别播放设备" VerticalAlignment="Center" Margin="0 12 0 0" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0 12 0 0"
                          ItemsSource="{Binding AvailableMonitorDevices}"
                          SelectedValue="{Binding SelectedMonitorDevice, Mode=TwoWay}"
                          SelectedValuePath="DeviceId"
                          DisplayMemberPath="DisplayText" />

                <TextBlock Grid.Row="2" Text="同声输出设备" VerticalAlignment="Center" Margin="0 12 0 0" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0 12 0 0"
                          ItemsSource="{Binding AvailableTtsOutputDevices}"
                          SelectedValue="{Binding SelectedTtsOutputDevice, Mode=TwoWay}"
                          SelectedValuePath="DeviceId"
                          DisplayMemberPath="DisplayText" />

                <CheckBox Grid.Row="3" Grid.ColumnSpan="2"
                          Content="启用语音同传（麦克风）"
                          IsChecked="{Binding MicrophoneEnabled}"
                          Margin="0 16 0 0" />
            </Grid>

            <CheckBox Content="启用语音识别（播放设备）" IsChecked="{Binding MonitorEnabled}" />
            <TextBlock Text="提示：如果识别播放设备与同声输出设备一致，可能出现翻译语音再次被采集的反馈问题。"
                       Foreground="DarkGoldenrod"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsDeviceFeedbackRisk, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
