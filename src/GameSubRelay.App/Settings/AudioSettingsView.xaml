<UserControl
    x:Class="GameSubRelay.App.Settings.AudioSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:GameSubRelay.App"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <Grid Margin="0 0 0 18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="音频设备" />
                    <TextBlock
                        Margin="0 6 0 0"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{Binding DeviceStatusText}" />
                </StackPanel>

                <ui:Button
                    Grid.Column="1"
                    MinWidth="112"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    Command="{Binding DataContext.RefreshAudioDevicesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="刷新设备"
                    Icon="{ui:SymbolIcon ArrowClockwise20}" />
            </Grid>

            <Border Style="{StaticResource SectionPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="麦克风设备" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding AvailableMicrophones}"
                        SelectedValue="{Binding SelectedMicrophoneDevice, Mode=TwoWay}"
                        SelectedValuePath="DeviceId" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0 14 0 0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="语音识别播放设备" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0 14 0 0"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding AvailableMonitorDevices}"
                        SelectedValue="{Binding SelectedMonitorDevice, Mode=TwoWay}"
                        SelectedValuePath="DeviceId" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="0 14 0 0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="同声输出设备" />
                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0 14 0 0"
                        DisplayMemberPath="DisplayText"
                        ItemsSource="{Binding AvailableTtsOutputDevices}"
                        SelectedValue="{Binding SelectedTtsOutputDevice, Mode=TwoWay}"
                        SelectedValuePath="DeviceId" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionPanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="通道开关" />
                    <CheckBox
                        Content="启用同声传译（麦克风）"
                        IsChecked="{Binding MicrophoneEnabled}" />
                    <CheckBox
                        Margin="0 10 0 0"
                        Content="启用语音识别（播放设备）"
                        IsChecked="{Binding MonitorEnabled}" />
                    <TextBlock
                        Margin="0 12 0 0"
                        Foreground="{StaticResource AppWarningBrush}"
                        Text="提示：如果识别播放设备与同声输出设备一致，可能出现翻译语音再次被采集的反馈问题。"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsDeviceFeedbackRisk, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
