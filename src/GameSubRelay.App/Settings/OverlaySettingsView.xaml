<UserControl
    x:Class="GameSubRelay.App.Settings.OverlaySettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Margin="0 0 0 18">
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="字幕浮层" />
                <TextBlock
                    Margin="0 6 0 0"
                    Style="{StaticResource MutedTextStyle}"
                    Text="调整浮窗透明度、字号、最大行数，以及初始位置和大小。" />
            </StackPanel>

            <Border Style="{StaticResource SectionPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="透明度" />
                    <Slider
                        Grid.Row="0"
                        Grid.Column="1"
                        Minimum="0.2"
                        Maximum="0.95"
                        LargeChange="0.1"
                        SmallChange="0.01"
                        Value="{Binding Opacity, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource AppMutedTextBrush}"
                        Text="{Binding Opacity, StringFormat={}{0:P0}}" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0 16 0 0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="字号" />
                    <Slider
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0 16 0 0"
                        Minimum="14"
                        Maximum="40"
                        LargeChange="2"
                        SmallChange="1"
                        Value="{Binding FontSize, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0 16 0 0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource AppMutedTextBrush}"
                        Text="{Binding FontSize, StringFormat={}{0:0}}" />

                    <TextBlock
                        Grid.Row="2"
                        Margin="0 16 0 0"
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="最大行数" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Width="160"
                        Margin="0 16 0 0"
                        HorizontalAlignment="Left"
                        Text="{Binding MaxLines}" />
                    <CheckBox Grid.Row="3" Content="显示原文" IsChecked="{Binding OriginalEnabled}" />
                    <CheckBox Grid.Row="3"  Grid.Column="1"  Content="显示系统声音" IsChecked="{Binding SystemAudioEnabled}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionPanelStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="初始位置和大小" />
                    <UniformGrid Columns="2" Rows="2">
                        <StackPanel Margin="0 0 12 12">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="左" />
                            <TextBox Margin="0 6 0 0" Text="{Binding Left}" />
                        </StackPanel>
                        <StackPanel Margin="0 0 0 12">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="上" />
                            <TextBox Margin="0 6 0 0" Text="{Binding Top}" />
                        </StackPanel>
                        <StackPanel Margin="0 0 12 0">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="宽" />
                            <TextBox Margin="0 6 0 0" Text="{Binding Width}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="高" />
                            <TextBox Margin="0 6 0 0" Text="{Binding Height}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock
                        Margin="0 14 0 0"
                        Style="{StaticResource MutedTextStyle}"
                        Text="预览模式会根据设置立即生效，不需要重启。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
